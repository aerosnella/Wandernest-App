# Streamlit Community Cloud: paste the contents of this file (with real values) into
# App settings > Secrets. Top-level keys are exposed to the app as environment variables.
# Never commit a real secrets.toml.

AZURE_OPENAI_API_KEY = "<your-azure-openai-key>"
AZURE_OPENAI_ENDPOINT = "https://aerosai.azure-api.net/Aerosaihub"
AZURE_OPENAI_API_VERSION = "2025-03-01-preview"
AZURE_OPENAI_CHAT_DEPLOYMENT = "gpt-5.4"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT = "text-embedding-3-small-2"

AZURE_SEARCH_ENDPOINT = "https://wandersearch.search.windows.net"
AZURE_SEARCH_KEY = "<your-search-admin-key>"
AZURE_SEARCH_INDEX_NAME = "wandernest-travel-index"

AZURE_CONTENT_SAFETY_ENDPOINT = "https://wandersafety.cognitiveservices.azure.com/"
AZURE_CONTENT_SAFETY_KEY = "<your-content-safety-key>"
